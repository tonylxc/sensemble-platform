# 复制为 .env 后按需修改；生产务必改 SECRET_KEY 与各密码
# --- App ---
SECRET_KEY=change-me-in-prod-please
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
CORS_ORIGINS=*
# 前端对外端口（宝塔等占用 80 时设为 8080）
FRONTEND_PORT=80
# 每设备最小上报间隔(秒)，0=不限流；生产建议 1.0
RATE_LIMIT_MIN_INTERVAL=0
# --- DB (TimescaleDB/PostGIS) ---
DB_HOST=db
DB_PORT=5432
DB_USER=sensemble
DB_PASSWORD=sensemble
DB_NAME=sensemble
# --- MQTT (EMQX) ---
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_TOPIC=sensemble/+/data
MQTT_ENABLED=true
# 后端 ingest 在 EMQX 的服务账号（超级用户）
MQTT_BACKEND_USER=backend-ingest
MQTT_BACKEND_PASSWORD=backend-ingest-secret
# EMQX 认证回调共享密钥：须与 emqx/emqx.conf 里的 x-emqx-secret 一致
MQTT_AUTH_SECRET=change-me-internal
# --- MinIO (对象存储，P1) ---
MINIO_ENDPOINT=minio:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
# --- Grafana (监控面板) ---
GRAFANA_PASSWORD=admin
